#usda 1.0
# SPDX-License-Identifier: Apache-2.0

(
    defaultPrim = "World"
)

def Xform "World"
{
    def Sphere "Sphere" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Red>
    }

    def Scope "Looks"
    {
        def Material "Red"
        {
            token outputs:mdl:surface.connect = </World/Looks/Red/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @mdl/example_package/example_module.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "red"
                token outputs:out
            }
        }
    }
}
