mdl 1.8;

import ::df::*;
import ::state::*;
import ::tex::*;

export using ::tex import wrap_mode;


export bool[4] test_bool_array
(
    bool[4] param = bool[](
        true,
        false,
        true,
        false)
)
{
    return param;
}

export material test_bsdfMeasurement_array
(
    uniform bsdf_measurement[2] param = bsdf_measurement[](
        bsdf_measurement("./resources/one.mbsdf"),
        bsdf_measurement("./resources/two.mbsdf"))
) =
material(
    surface: material_surface(
        scattering: df::fresnel_layer(
            ior: 1.5,
            layer: df::measured_bsdf(measurement: param[0]),
            base: df::measured_bsdf(measurement: param[1])
        )
    )
);


