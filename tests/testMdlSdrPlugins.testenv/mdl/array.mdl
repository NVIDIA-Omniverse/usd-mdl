export material test_lightProfile_array
(
    uniform light_profile[2] param = light_profile[](
        light_profile("./resources/one.ies"),
        light_profile("./resources/two.ies"))
) =
material (
    surface: material_surface (
        emission:  material_emission (
            emission: df::clamped_mix(
                df::edf_component[](
                    df::edf_component(0.5, df::measured_edf(profile: param[0])),
                    df::edf_component(0.5, df::measured_edf(profile: param[1]))
                )
            )
        )
    )
);

export string[5] test_string_array
(
    string[5] param = string[]("my", "mind", "is", "going", "")
)
{
    return param;
}

export color test_texture2D_array
(
    uniform texture_2d[2] param = texture_2d[](
        texture_2d("./resources/one.png", ::tex::gamma_linear),
        texture_2d("./resources/two.png", ::tex::gamma_srgb))
)
{
    float3 tex_coord3 = state::texture_coordinate(0);
    float2 text_coord2(tex_coord3.x, tex_coord3.y);
    return tex::lookup_color(param[0], text_coord2) + tex::lookup_color(param[1], text_coord2);
}

export color test_texture3D_array
(
    // texture_3d (.vdb) load is unsupported - the SDK ships no image
    // plugin for that format.  Empty constructors keep load_module
    // succeeding for the rest of array.mdl; tests cover the empty defaults
    // and declared array type.
    uniform texture_3d[2] param = texture_3d[](
        texture_3d(),
        texture_3d())
)
{
    return tex::lookup_color(param[0], state::texture_coordinate(0)) + tex::lookup_color(param[1], state::texture_coordinate(0));
}

export color test_textureCube_array
(
    uniform texture_cube[2] param = texture_cube[](
        texture_cube("./resources/one.cube.png", ::tex::gamma_linear),
        texture_cube("./resources/two.cube.png", ::tex::gamma_srgb))
)
{
    return tex::lookup_color(param[0], state::texture_coordinate(0)) + tex::lookup_color(param[1], state::texture_coordinate(0));
}

export color test_texturePtex_array
(
    // texture_ptex load is unsupported - the SDK ships no Ptex image
    // plugin.  Empty constructors keep load_module succeeding for
    // the rest of array.mdl; tests cover the empty defaults and
    // declared array type.
    uniform texture_ptex[2] param = texture_ptex[](
        texture_ptex(),
        texture_ptex())
)
{
    return tex::lookup_color(param[0]) + tex::lookup_color(param[1]);
}

