export wrap_mode[3] test_enum_array
(
    wrap_mode[3] param = wrap_mode[](
        ::tex::wrap_clip,
        ::tex::wrap_mirrored_repeat,
        ::tex::wrap_clamp)
)
{
    return param;
}

