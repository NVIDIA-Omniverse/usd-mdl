mdl 1.8;

import ::anno::*;

// Hidden affects UI presentation. It must not prevent registration or lookup.
// The SDK's removal status is authoritative; a user-authored removed_since
// annotation does not necessarily set IFunction_definition::get_mdl_version().

export int test_visible(int param = 1) { return param; }

export int test_hidden(int param = 2)
[[ anno::hidden() ]]
{ return param; }

export int test_removed(int param = 3)
[[ anno::removed_since(1, 4, 0) ]]
{ return param; }
