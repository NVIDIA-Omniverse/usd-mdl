export material_geometry pass_material_geometry(material_geometry value) = value;
export int builtin(intensity_mode value) { return 1; }
export int builtin_array(bool[2] values) { return 2; }
export int builtin_array(int[2] values) { return 2; }
export int builtin_array(float[2] values) { return 2; }
