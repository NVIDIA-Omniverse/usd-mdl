include_guard(GLOBAL)

# Keep resource discovery inside the SDK selected by find_package(pxr). The
# package may put its config at the prefix or under lib/cmake/pxr (e.g. conda).
function(usdmdl_generate_shader_definitions target)
    set(USDMDL_USD_SHADER_DEFINITIONS "" CACHE FILEPATH
        "Canonical usdShaders shaderDefs.usda; empty locates it in the selected USD SDK")
    set(USDMDL_USD_SHADER_DEFINITIONS_LICENSE
        "${PROJECT_SOURCE_DIR}/src/usdMdl/resources/OpenUSD-LICENSE.txt" CACHE FILEPATH
        "OpenUSD license to accompany generated shader definitions")
    set(USDMDL_USD_SHADER_DEFINITIONS_NOTICE
        "${PROJECT_SOURCE_DIR}/src/usdMdl/resources/OpenUSD-NOTICE.txt" CACHE FILEPATH
        "OpenUSD attribution notice to accompany generated shader definitions")
    set(_prefixes "")
    foreach(_include IN LISTS PXR_INCLUDE_DIRS)
        if(EXISTS "${_include}/pxr/pxr.h")
            get_filename_component(_prefix "${_include}" DIRECTORY)
            list(APPEND _prefixes "${_prefix}")
        endif()
    endforeach()
    foreach(_config IN ITEMS "${PXR_CMAKE_DIR}" "${pxr_DIR}")
        if(NOT _config)
            continue()
        endif()
        get_filename_component(_candidate "${_config}" ABSOLUTE)
        foreach(_level RANGE 0 5)
            if(EXISTS "${_candidate}/include/pxr/pxr.h")
                list(APPEND _prefixes "${_candidate}")
            endif()
            get_filename_component(_parent "${_candidate}" DIRECTORY)
            if(_parent STREQUAL _candidate)
                break()
            endif()
            set(_candidate "${_parent}")
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES _prefixes)
    if(NOT _prefixes)
        message(FATAL_ERROR "Cannot locate the selected pxr SDK prefix for shader-definition generation.")
    endif()
    list(GET _prefixes 0 _sdk_prefix)
    file(REAL_PATH "${_sdk_prefix}" _sdk_prefix)
    set(_canonical_paths "")
    foreach(_layout IN ITEMS plugin/usd lib/usd)
        set(_candidate "${_sdk_prefix}/${_layout}/usdShaders/resources/shaders/shaderDefs.usda")
        if(EXISTS "${_candidate}")
            file(REAL_PATH "${_candidate}" _candidate)
            list(APPEND _canonical_paths "${_candidate}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES _canonical_paths)
    if(USDMDL_USD_SHADER_DEFINITIONS)
        get_filename_component(_input "${USDMDL_USD_SHADER_DEFINITIONS}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
    elseif(_canonical_paths)
        list(GET _canonical_paths 0 _input)
        file(SHA256 "${_input}" _input_hash)
        foreach(_other IN LISTS _canonical_paths)
            file(SHA256 "${_other}" _other_hash)
            if(NOT _input_hash STREQUAL _other_hash)
                message(FATAL_ERROR "Selected USD SDK has different canonical shader resources; set USDMDL_USD_SHADER_DEFINITIONS explicitly.")
            endif()
        endforeach()
    else()
        message(FATAL_ERROR "Selected USD SDK ${_sdk_prefix} has no usdShaders shaderDefs.usda. Set USDMDL_USD_SHADER_DEFINITIONS to the matching canonical source file.")
    endif()
    if(NOT EXISTS "${_input}" OR IS_DIRECTORY "${_input}")
        message(FATAL_ERROR "Canonical USD shader definitions do not exist: ${_input}")
    endif()
    file(REAL_PATH "${_input}" _input)
    get_filename_component(_license "${USDMDL_USD_SHADER_DEFINITIONS_LICENSE}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
    if(NOT EXISTS "${_license}" OR IS_DIRECTORY "${_license}")
        message(FATAL_ERROR "Shader-definition license does not exist: ${_license}")
    endif()
    file(REAL_PATH "${_license}" _license)
    get_filename_component(_notice "${USDMDL_USD_SHADER_DEFINITIONS_NOTICE}" ABSOLUTE BASE_DIR "${PROJECT_SOURCE_DIR}")
    if(NOT EXISTS "${_notice}" OR IS_DIRECTORY "${_notice}")
        message(FATAL_ERROR "Shader-definition notice does not exist: ${_notice}")
    endif()
    file(REAL_PATH "${_notice}" _notice)
    set(_python_candidates
        "${_sdk_prefix}/lib/python"
        "${_sdk_prefix}/Lib/site-packages"
        "${_sdk_prefix}/lib/python${Python3_VERSION_MAJOR}.${Python3_VERSION_MINOR}/site-packages"
        "${_sdk_prefix}/lib64/python${Python3_VERSION_MAJOR}.${Python3_VERSION_MINOR}/site-packages")
    if(WIN32 AND EXISTS "${_sdk_prefix}/../Lib/site-packages/pxr/__init__.py")
        # Windows conda places native SDK files in Library and Python beside it.
        list(APPEND _python_candidates "${_sdk_prefix}/../Lib/site-packages")
    endif()
    set(_usd_python "")
    foreach(_candidate IN LISTS _python_candidates)
        if(EXISTS "${_candidate}/pxr/__init__.py")
            file(REAL_PATH "${_candidate}" _usd_python)
            break()
        endif()
    endforeach()
    if(NOT _usd_python)
        message(FATAL_ERROR "Shader-definition generation requires host-compatible Python bindings from the selected USD SDK ${_sdk_prefix}.")
    endif()
    foreach(_component IN ITEMS PXR_MAJOR_VERSION PXR_MINOR_VERSION PXR_PATCH_VERSION)
        if(NOT DEFINED ${_component})
            message(FATAL_ERROR "Selected pxr package does not report ${_component} for generator version verification.")
        endif()
    endforeach()
    set(_usd_version "${PXR_MAJOR_VERSION}.${PXR_MINOR_VERSION}.${PXR_PATCH_VERSION}")
    set(_generator "${PROJECT_SOURCE_DIR}/tools/generateShaderDefinitions.py")
    set(_sdk_args --usd-version "${_usd_version}" --usd-python "${_usd_python}" --usd-prefix "${_sdk_prefix}")
    set(_runner "${CMAKE_COMMAND}" -E env)
    if(UNIX)
        if(APPLE)
            set(_loader DYLD_LIBRARY_PATH)
        else()
            set(_loader LD_LIBRARY_PATH)
        endif()
        set(_loader_path "${_sdk_prefix}/lib:${_sdk_prefix}/lib64:${_sdk_prefix}/bin")
        if(NOT "$ENV{${_loader}}" STREQUAL "")
            string(APPEND _loader_path ":$ENV{${_loader}}")
        endif()
        list(APPEND _runner "${_loader}=${_loader_path}")
    endif()
    list(APPEND _runner "${Python3_EXECUTABLE}" -I "${_generator}")
    execute_process(COMMAND ${_runner} --probe ${_sdk_args}
        RESULT_VARIABLE _probe_result OUTPUT_VARIABLE _probe_output ERROR_VARIABLE _probe_error
        TIMEOUT 45)
    if(NOT _probe_result EQUAL 0)
        message(FATAL_ERROR "Cannot run shader-definition generator with selected USD bindings (cross builds require compatible host bindings):\n${_probe_output}${_probe_error}")
    endif()
    message(STATUS "Generating MDL shader interfaces from selected OpenUSD ${_usd_version}: ${_input}")
    set(_resources "${CMAKE_CURRENT_BINARY_DIR}/resources")
    file(MAKE_DIRECTORY "${_resources}")
    # This dependency changes when the selected SDK/input changes even if the
    # replacement SDK's resource timestamp is older than the previous output.
    set(_selection "${_resources}/selected-usd.txt")
    set(_selection_content "version=${_usd_version}\ninput=${_input}\nlicense=${_license}\nnotice=${_notice}\npython=${Python3_EXECUTABLE}\npackage=${_usd_python}\nprefix=${_sdk_prefix}\n")
    set(_previous_selection "")
    if(EXISTS "${_selection}")
        file(READ "${_selection}" _previous_selection)
    endif()
    if(NOT _previous_selection STREQUAL _selection_content)
        file(WRITE "${_selection}" "${_selection_content}")
    endif()
    set(_output "${_resources}/UsdPreviewSurface.usda")
    set(_provenance "${_resources}/UsdPreviewSurface.provenance.json")
    set(_license_output "${_resources}/OpenUSD-LICENSE.txt")
    set(_notice_output "${_resources}/OpenUSD-NOTICE.txt")
    add_custom_command(OUTPUT "${_output}" "${_provenance}" "${_license_output}" "${_notice_output}"
        COMMAND ${_runner} ${_sdk_args}
            --input "${_input}" --output "${_output}" --provenance "${_provenance}"
            --license "${_license}" --license-output "${_license_output}" --notice "${_notice}"
        # The script keeps unchanged content stable. Mark successful dependency
        # processing complete so an input-only timestamp change runs just once.
        COMMAND "${CMAKE_COMMAND}" -E touch "${_output}" "${_provenance}" "${_license_output}" "${_notice_output}"
        DEPENDS "${_generator}" "${_input}" "${_license}" "${_notice}" "${_selection}"
        COMMENT "Generate MDL shader-definition resource for OpenUSD ${_usd_version}"
        VERBATIM)
    add_custom_target(usdMdlShaderDefinitions DEPENDS "${_output}" "${_provenance}" "${_license_output}" "${_notice_output}")
    add_dependencies(${target} usdMdlShaderDefinitions)
    set(_manifest "")
    foreach(_layout IN ITEMS plugin/usd lib/usd)
        set(_candidate "${_sdk_prefix}/${_layout}/usdShaders/resources/plugInfo.json")
        if(EXISTS "${_candidate}")
            set(_manifest "${_candidate}")
            break()
        endif()
    endforeach()
    set(MDL_TEST_PXR_PYTHON_DIR "${_usd_python}" CACHE INTERNAL "Selected OpenUSD Python package for tests" FORCE)
    set(USDMDL_USD_SHADER_DEFINITIONS_INPUT "${_input}" PARENT_SCOPE)
    set(USDMDL_USD_SHADER_DEFINITIONS_SELECTED_LICENSE "${_license}" PARENT_SCOPE)
    set(USDMDL_USD_SHADER_DEFINITIONS_SELECTED_NOTICE "${_notice}" PARENT_SCOPE)
    set(USDMDL_USD_PYTHON_PACKAGE "${_usd_python}" PARENT_SCOPE)
    set(USDMDL_USD_SDK_PREFIX "${_sdk_prefix}" PARENT_SCOPE)
    set(USDMDL_USD_VERSION "${_usd_version}" PARENT_SCOPE)
    set(USDMDL_USD_PLUGIN_MANIFEST "${_manifest}" PARENT_SCOPE)
    set(USDMDL_SHADER_DEFINITIONS_OUTPUT "${_output}" PARENT_SCOPE)
    set(USDMDL_SHADER_DEFINITIONS_PROVENANCE "${_provenance}" PARENT_SCOPE)
    set(USDMDL_SHADER_DEFINITIONS_LICENSE_OUTPUT "${_license_output}" PARENT_SCOPE)
    set(USDMDL_SHADER_DEFINITIONS_NOTICE_OUTPUT "${_notice_output}" PARENT_SCOPE)
endfunction()
